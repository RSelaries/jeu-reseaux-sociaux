; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Jeu Réseaux Sociaux"
config/tags=PackedStringArray("\"finished\"_game", "sirius")
run/main_scene="uid://rt841ber88tv"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://dxfd3cvjhocfi"

[autoload]

DataAccess="*res://autoloads/data_access.gd"
ScoreManager="*res://autoloads/scores/score_manager.gd"
ReponseManager="*res://autoloads/reponse_manager/reponse_manager.tscn"
LevelsManager="*res://autoloads/levels_manager.gd"
DebugScene="*res://autoloads/debug_scene/debug_scene.tscn"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/csv-data-importer/plugin.cfg", "res://addons/parcour_inspector_plugin/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "red",
"res://autoloads/": "green",
"res://data/": "pink",
"res://scenes/": "blue",
"res://scenes/questions_templates/": "purple",
"res://scenes/questions_templates/qcm_question/": "purple",
"res://scenes/questions_templates/sondage/": "purple",
"res://scenes/questions_templates/vrai_faux/": "purple"
}

